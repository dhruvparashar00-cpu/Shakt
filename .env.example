# Shakt Environment Variables
# Copy this file to .env and fill in your values.
# .env is excluded from git via .gitignore — never commit real secrets.

# Anthropic API Key (server-side only — never exposed to frontend)
# Get one at: https://console.anthropic.com/
ANTHROPIC_AUTH_TOKEN=sk-ant-api03-your-key-here
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Custom base URL for API proxy (e.g. OmniRoute at localhost:20128)
# Leave empty to use https://api.anthropic.com directly
ANTHROPIC_BASE_URL=http://localhost:20128

# Optional: Default model override
ANTHROPIC_MODEL=omni-route

# Server port
PORT=3000
